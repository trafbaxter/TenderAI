# Ignore node_modules in frontend but allow package.json and yarn.lock
frontend/node_modules/
# Allow essential files explicitly
!frontend/package.json
!frontend/yarn.lock
# Ignore git files
.git/
.gitignore
# Ignore build artifacts
frontend/build/
# Ignore test files
**/*.test.js
**/*.test.ts
**/*.spec.js
**/*.spec.ts
# Ignore logs
*.log
**/*.log
# Ignore OS files
.DS_Store
Thumbs.db
# Ignore IDE files
.vscode/
.idea/
*.swp
*.swo
# Ignore temporary files
*.tmp
.temp/
# Ignore markdown files (but keep README.md)
*.md
!README.md
# Ignore terraform state (but not yarn.lock)
terraform/.terraform/
terraform/terraform.tfstate*
terraform/.terraform.lock.hcl