# TenderAI with n8n Integration Environment Configuration

# Environment Configuration
ENVIRONMENT=development
LOG_LEVEL=info

# n8n Configuration
N8N_HOST=0.0.0.0
N8N_PORT=5678
N8N_AUTH_USER=admin
N8N_AUTH_PASSWORD=secure_admin_password
N8N_DB_PASSWORD=n8n_secure_db_password
N8N_ENCRYPTION_KEY=very_secure_encryption_key_32_chars
N8N_JWT_SECRET=jwt_secret_key_for_n8n_auth
N8N_API_KEY=n8n_api_integration_key
WEBHOOK_BASE_URL=http://localhost:5678

# Database Configuration
DATABASE_URL=postgresql://tenderai:tenderai_password@localhost:5432/tenderai
REDIS_PASSWORD=redis_secure_password

# API Configuration
API_PORT=8001
TENDERAI_API_KEY=tenderai_backend_api_key
JWT_SECRET_KEY=jwt_secret_for_tenderai_auth

# Frontend Configuration
FRONTEND_PORT=8080
FRONTEND_API_BASE_URL=http://localhost:8001/api/v1
FRONTEND_WEBHOOK_URL=http://localhost:5678/webhook

# Monitoring Configuration
GRAFANA_PASSWORD=grafana_admin_password

# Google Cloud Configuration (for production)
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json